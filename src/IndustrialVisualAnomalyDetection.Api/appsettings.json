{
  "ImageUpload": {
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg"
    ]
  },
  "PythonInference": {
    "BaseUrl": "http://localhost:8000",
    "PredictionPath": "/api/v1/predictions",
    "HealthPath": "/health/live",
    "TimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
